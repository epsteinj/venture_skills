# Specter  (https://api.tryspecter.com/api-ref/introduction)
SPECTER_API_KEY=your-specter-api-key
SPECTER_BASE_URL=https://app.tryspecter.com/api/v1
# Provide ONE of these – the lead source to pull from:
SPECTER_PEOPLE_LIST_ID=
SPECTER_SAVED_SEARCH_ID=

# Affinity
AFFINITY_API_KEY=your-affinity-api-key

# N8N - webhook URL for creating Outlook drafts
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/outlook-draft

# Cold email settings
DAYS_SINCE_LAST_INTERACTION=90
SENDER_EMAIL=you@yourcompany.com
